# Lameness Detection System - Environment Configuration
# Copy this file to .env and modify as needed
# Usage: cp env.example .env

# ============== HOST CONFIGURATION ==============
# The hostname/IP where services are accessible
DEPLOY_HOST=localhost

# ============== SERVICE PORTS ==============
POSTGRES_PORT=5432
NATS_PORT=4222
QDRANT_PORT=6333
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ============== DATABASE ==============
POSTGRES_USER=lameness_user
POSTGRES_DB=lameness_db
POSTGRES_PASSWORD=lameness_pass

# ============== QDRANT ==============
# Embedding vector size (768 for DINOv3)
QDRANT_EMBEDDING_SIZE=768

# ============== NATS ==============
NATS_URL=nats://nats:4222

# ============== LONG VIDEO PREPROCESSING ==============
# YOLO model weights for long video processing
# LONG_VIDEO_YOLO_MODEL=yolov8l.pt
# LONG_VIDEO_YOLO_CONF=0.3
# LONG_VIDEO_YOLO_IOU=0.3
# Override bad video threshold from model metadata
# LONG_VIDEO_BAD_THRESHOLD=0.1

# ============== LLM CONFIGURATION ==============
# Priority: OpenAI > Ollama Local > Skip
# Set OPENAI_API_KEY to use OpenAI (preferred)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Ollama Local LLM (fallback if no OpenAI key)
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2
# Recommended models: llama3.2, mistral, phi3, gemma2

# ============== API CONFIGURATION ==============
# For production, set your actual domain
# VITE_API_URL=https://api.yourdomain.com

# ============== TENANTS ==============
# Default tenant name for new researchers (Farm1, Farm2, etc.)
# DEFAULT_TENANT_NAME=Farm1

# ============== STORAGE ==============
# Use "local" for out-of-the-box local testing (no S3 credentials required).
# Use "s3" when you want object-storage-backed upload/download.
STORAGE_BACKEND=local

# S3 settings (required only when STORAGE_BACKEND=s3)
# S3_VIDEOS_BUCKET=your-bucket-name
# S3_ENDPOINT_URL=https://object-arbutus.cloud.computecanada.ca
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=true
# S3_LONG_VIDEOS_PREFIX=raw_videos/
# S3_SHORT_VIDEOS_PREFIX=short_videos/

# ============== DOCKER COMPOSE ==============
# Leave empty to auto-detect in scripts/deploy.sh and start_docker scripts.
# Set explicitly only if you want to force one mode.
# COMPOSE_PROFILES=gpu